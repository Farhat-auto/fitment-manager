{
  "name": "fitment-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:shopify": "node scripts/shopify-dev.mjs",
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:test-fitment": "node scripts/seed-test-fitment.mjs",
    "sync:fitment": "node scripts/sync-fitment.mjs",
    "backfill:search-index": "node scripts/backfill-search-index.mjs",
    "backfill:fitment-keys": "node scripts/backfill-fitment-keys.mjs",
    "test:oe-normalize": "node scripts/test-oe-search-normalize.mjs",
    "test:supabase": "node scripts/test-supabase-connection.mjs",
    "test:ocean-identity": "node --experimental-strip-types tests/identity-isolation.test.ts",
    "test:embedded-nav": "node --experimental-strip-types tests/embedded-nav.test.ts",
    "test:fitment-throttle": "node --experimental-strip-types tests/fitment-throttle.test.ts",
    "test:fitment-cascade": "node --experimental-strip-types tests/fitment-cascade.test.ts",
    "test:fitment-index": "node --experimental-strip-types tests/fitment-index-state.test.ts",
    "test:ocean-picker": "node --experimental-strip-types tests/ocean-vehicle-picker.test.ts",
    "test:ocean-invalid-url": "node --experimental-strip-types tests/ocean-invalid-url.test.ts",
    "test": "npm run test:ocean-identity && npm run test:embedded-nav && npm run test:fitment-throttle && npm run test:fitment-cascade && npm run test:fitment-index && npm run test:ocean-picker && npm run test:ocean-invalid-url"
  },
  "dependencies": {
    "@remix-run/node": "^2.12.1",
    "@remix-run/react": "^2.12.1",
    "@remix-run/serve": "^2.12.1",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-api": "^11.13.0",
    "@shopify/shopify-app-remix": "^3.6.2",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/remix": "^2.16.7",
    "dotenv": "^17.4.2",
    "isbot": "^5.1.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tiny-invariant": "^1.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.12.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
