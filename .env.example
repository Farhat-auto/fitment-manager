
# Shopify CLI: must be an existing Development store or Plus Sandbox (Partner dashboard → Stores → select store marked "Development").
# Set this (e.g. in .env.local) so `npm run dev:shopify` runs: shopify app dev --store YOUR-STORE.myshopify.com
# SHOPIFY_CLI_DEV_STORE=your-dev-store.myshopify.com

SHOPIFY_APP_URL=https://fitment-manager.vercel.app
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=read_products,write_products,read_metaobjects,write_metaobjects
# Custom app must expose these Admin API scopes; token (shpat_) must be created AFTER scopes are enabled.

# Embedded app / CLI: backfill & sync can use the offline token from Supabase `shopify_sessions`
# when SHOPIFY_ADMIN_ACCESS_TOKEN is omitted (same DB as Remix Session storage).
# Optional: SHOPIFY_SESSIONS_TABLE=shopify_sessions

# Required Admin API scopes for the app install: read_products, write_products (backfill, metafields).
# If you see ACCESS_DENIED on `products`, add scopes in Partner app config, reinstall on the store, and ensure the offline session in Supabase is current.

SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_api_access_token
# Optional alias if your tooling sets this instead:
# SHOPIFY_ACCESS_TOKEN=shpat_your_admin_api_access_token

# Alternative to putting shpat_ in .env: create `.shopify-admin-token` in this folder (single line, gitignored).
# Or use `.env.local` with SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_… (override; matches *.local ignore rules).

SHOPIFY_ADMIN_API_VERSION=2024-10

# Example:
# SHOP_DOMAIN=g5uxzq-gb.myshopify.com
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_token_here
#
# Then run:
#   npm run backfill:search-index
#   npm run sync:fitment

# Supabase (server-side only; use Service Role key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

